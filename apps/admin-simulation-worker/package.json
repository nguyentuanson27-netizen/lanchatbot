{
  "name": "@lana/admin-simulation-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @lana/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @lana/contracts build",
