{"schemaVersion":1,"population":"AUTHORED_SYNTHETIC_EVALUATION_NOT_REAL_SHOP","sourceVersion":"authored-evaluation-product-context-r15","profileDetails":{"ST411":{"silhouette":"Hình thức bán: cả set áo và quần. Áo sơ mi dáng rộng. Quần ống suông, lưng chun toàn vòng.","material":"Vải: 65% polyester, 35% viscose, không co giãn. Số đo trên quần: chun kéo tối đa S82/M88/L94cm. Thử gấp cùng điều kiện: ít nhăn hơn linen; vẫn có thể nhăn. Phép thử này không đo độ bền, giữ phom cả ngày hoặc thời gian không cần là.","limitations":"Bảng tách số đo thành phẩm và khoảng cơ thể; độ kéo chun là số đo trên quần. Có thiết kế và code-fit để tư vấn cảm giác mặc dự kiến; không có phép thử cảm giác cả ngày. Kết quả gấp chỉ so độ nhăn với linen, không đo độ bền, giữ phom theo thời gian hay miễn là ủi."},"VA512":{"silhouette":"Váy midi chữ A, cổ vuông, tay ngắn. Eo cố định; lót toàn thân.","material":"Crepe 100% polyester, không co giãn. Phần eo không có chun. Lót che thân váy trong ánh sáng phòng thông thường.","limitations":"Bảng tách số đo thành phẩm và khoảng cơ thể. Eo cố định, có lót toàn thân. Độ che của lót đã xác nhận chỉ trong ánh sáng phòng; không có kết quả mọi ánh sáng hoặc thử cảm giác mặc cả ngày."},"SM613":{"silhouette":"Hình thức bán: riêng áo. Sơ mi tay dài, dáng thẳng, cổ bẻ.","material":"Vải: 100% cotton dệt dày 180g/m², không co giãn. Phép thử của shop cho màu trắng: ánh sáng phòng, áo lót màu da — không thấy màu áo lót. Đèn ngược sáng — có thể thấy bóng áo lót.","limitations":"Bảng áo dùng vòng ngực cơ thể. Phép thử độ xuyên thuộc màu trắng và hai điều kiện ánh sáng ghi ở material; chưa có kết quả độ xuyên màu xanh nhạt. Đây là thử của shop, không phải hãng. Dữ liệu màu để tư vấn phối đồ không phải kết quả độ kín."},"QU714":{"silhouette":"Hình thức bán: riêng quần. Ống suông; cạp trước phẳng, chun ở phần sau.","material":"Vải: 68% polyester, 30% viscose, 2% elastane; co giãn nhẹ. Số đo trên quần: eo kéo tối đa S78/M84/L90cm.","limitations":"Bảng tách số đo thành phẩm và khoảng eo/mông cơ thể; độ kéo chun là số đo trên quần. Thiết kế/chun sau và code-fit hỗ trợ cảm giác mặc dự kiến; không có phép thử cảm giác mọi người hoặc mọi điều kiện."}},"quoteAdmissions":[{"caseId":"r5-workday-comfort","destinationEstablished":false,"destination":null},{"caseId":"r5-competitor-price","destinationEstablished":false,"destination":null},{"caseId":"r5-wardrobe-budget","destinationEstablished":true,"destination":"INNER_HCMC"},{"caseId":"r5-white-opacity","destinationEstablished":false,"destination":null},{"caseId":"r5-size-price-stock","destinationEstablished":true,"destination":"INNER_HCMC"},{"caseId":"r5-missing-customer-size","destinationEstablished":true,"destination":"INNER_HCMC"},{"caseId":"r5-white-variant-alternative","destinationEstablished":false,"destination":null},{"caseId":"r5-delivery-timing","destinationEstablished":true,"destination":"INNER_HCMC"},{"caseId":"r5-correct-product","destinationEstablished":false,"destination":null},{"caseId":"r5-correct-measurement","destinationEstablished":false,"destination":null},{"caseId":"r5-referent-navy","destinationEstablished":false,"destination":null},{"caseId":"r5-budget-correction","destinationEstablished":true,"destination":"INNER_HCMC"},{"caseId":"r5-defer","destinationEstablished":false,"destination":null},{"caseId":"r5-try-exchange","destinationEstablished":false,"destination":null},{"caseId":"r5-exchange-cost","destinationEstablished":false,"destination":null},{"caseId":"r5-shipping-threshold","destinationEstablished":true,"destination":"INNER_HCMC"},{"caseId":"r5-refund-distinction","destinationEstablished":false,"destination":null},{"caseId":"r5-simple-price","destinationEstablished":false,"destination":null},{"caseId":"r5-simple-stock","destinationEstablished":false,"destination":null},{"caseId":"r5-simple-ack","destinationEstablished":false,"destination":null},{"caseId":"r7-price-ready-fit","destinationEstablished":false,"destination":null},{"caseId":"r7-shirt-missing-measure",