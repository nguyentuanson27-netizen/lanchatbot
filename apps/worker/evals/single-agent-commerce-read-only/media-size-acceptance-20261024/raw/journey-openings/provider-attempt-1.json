            },
            {
              "ref": "SQ2447",
              "kind": "PRODUCT",
              "label": "Set quần Thạch Thảo",
              "bindingVersion": "commerce:1:7bbc5ec60b00da8b7438a6b86dac884a8829c0be4d8e05d29533634081ad3683"
            }
          ],
          "products": [
            {
              "ref": "product:SQ748",
              "subjectRef": "SQ748",
              "content": {
                "productName": "SET QUẦN UYỂN HOA",
                "description": "Màu sắc Tone kem phối họa tiết thổ cẩm hồng pastel và be nhạt, mang đến tổng thể ngọt ngào, thanh lịch và nữ tính. Set được may từ vải thô đũi cao cấp với bề mặt mềm mịn, thoáng khí và thấm hút tốt, mang lại cảm giác nhẹ nhàng, dễ chịu khi mặc Set gồm á kết hợp quần short lưng chun đồng bộ, chi tiết bèo xếp tầng ở gấu áo giúp tôn vòng eo và tạo hiệu ứng mềm mại, nữ tính. Quần short form suông, chiều dài vừa vặn giúp tôn dáng và tạo sự thoải mái khi vận động.",
                "productUrl": null,
                "metadata": {
                  "authority": "WEBSTORE_XML",
                  "sourceVersion": "catalog-v2",
                  "observedAt": "2026-09-28T04:31:05.725Z",
                  "expiresAt": null,
                  "freshForSeconds": null,
                  "freshnessState": "FRESH"
                }
              }
            },
            {
              "ref": "product:V406",
              "subjectRef": "V406",
              "content": {
                "productName": "Váy Ngọc Trâm",
                "description": "Thiết kế nữ tính, thanh lịch với sự kết hợp giữa ren hoa nổi sang trọng và tơ ống mềm nhẹ, tạo cảm giác mềm mại, thoáng mát và bay nhẹ khi mặc. Chất liệu mịn, rũ tự nhiên giúp tôn lên vẻ dịu dàng và tinh tế cho người mặc. Phần váy yếm 2 lớp tơ ống được thiết kế form nhẹ nhàng, tạo độ rủ mềm và giúp dáng váy đứng form đẹp. Đi kèm là khăn choàng ren hoa nổi 1 lớp, tạo điểm nhấn duyên dáng, tăng thêm nét sang trọng và nữ tính cho tổng thể trang phục. Sự kết hợp giữa váy yếm và khăn ren giúp set đồ trở nên nổi bật, vừa mềm mại vừa thanh lịch.",
                "productUrl": null,
                "metadata": {
                  "authority": "WEBSTORE_XML",
                  "sourceVersion": "catalog-v2",
                  "observedAt": "2026-09-05T10:07:31.041Z",
                  "expiresAt": null,
                  "freshForSeconds": null,
                  "freshnessState": "FRESH"
                }
              }
            },
            {
              "ref": "product:SQ2447",
              "subjectRef": "SQ2447",
              "content": {
                "productName": "Set quần Thạch Thảo",
                "description": "Thiết kế đồng bộ, tinh tế với chất liệu tơ Hàn thêu cao cấp cho cả áo và quần, mang lại cảm giác nhẹ nhàng, mềm mại và bay bổng khi mặc. Bề mặt vải được thêu họa tiết tinh xảo, tạo điểm nhấn sang trọng và cuốn hút. Áo được thiết kế form nhẹ nhàng, giúp tôn dáng thanh thoát nhưng vẫn đảm bảo sự thoải mái. Các chi tiết thêu được xử lý tỉ mỉ, tạo hiệu ứng nổi bật nhưng không quá cầu kỳ, giữ được nét dịu dàng và thanh lịch. Quần được làm từ tơ Hàn thêu đồng bộ, mềm mịn, có độ rũ nhẹ giúp tổng thể trang phục hài hòa và tinh tế hơn. Thiết kế quần dễ mặc, phù hợp với nhiều vóc dáng. Tổng thể set đồ mang phong cách nữ tính – thanh lịch – hiện đại, dễ ứng dụng trong nhiều hoàn cảnh khác nhau.",
                "productUrl": null,
                "metadata": {
                  "authority": "WEBSTORE_XML",
                  "sourceVersion": "catalog-v2",
                  "observedAt": "2026-09-28T04:31:05.725Z",
                  "expiresAt": null,
                  "freshForSeconds": null,
                  "freshnessState": "FRESH"
                }
              }
            }
          ]
        }
      },
