{
  "name": "@lana/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm -r --filter \"@lana/worker^...\" build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm -r --filter \"@lana/worker^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -r --filter \"@lana/worker^...\" build",
    "benchmark:c2:validate": "node evals/track-c-c2/v2/validate-benchmark.mjs && node evals/track-c-c2/v2/validate-quality-harness.mjs && node evals/track-c-c2/v2/validate-journeys.mjs",
    "test": "pnpm benchmark:c2:validate && vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "meta-outbox:cancel": "node dist/meta-outbox-operator.js",
    "behavior-mode:operator": "node dist/runtime-behavior-mode-operator.js"
  },
  "dependencies": {
    "@lana/business-tools": "workspace:*",
    "@lana/chat-runtime": "workspace:*",
    "@lana/contracts": "workspace:*",
    "@lana/conversation-engine": "workspace:*",
    "@lana/database": "workspace:*",
    "@lana/dataset-review": "workspace:*",
    "@lana/dataset-store": "workspace:*",
    "@lana/durable-messaging": "workspace:*",
    "@lana/meta-delivery": "workspace:*",
    "@lana/meta-webhook": "workspace:*",
    "@lana/pancake-handoff": "workspace:*",
    "fast-xml-parser": "^5.10.1",
    "redis": "^5.8.2"
  }
}
