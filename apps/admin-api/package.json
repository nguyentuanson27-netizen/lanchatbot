{
  "name": "@lana/admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "pretest:postgres": "pnpm --filter @lana/contracts build && pnpm --filter @lana/database build && pnpm --filter @lana/dataset-store build",
    "test:postgres": "tsc -p tsconfig.json && node --test dist/policy-store.postgres-spec.js dist/track-b-0037-catalog.postgres-spec.js dist/track-b-0038-admission.postgres-spec.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@lana/contracts": "workspace:*",
    "@lana/database": "workspace:*",
    "@lana/dataset-store": "workspace:*",
    "fastify": "^5.11.3",
    "pg": "^8.16.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
