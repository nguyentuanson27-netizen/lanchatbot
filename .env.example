NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Safety defaults: Phase 1 must never send a real customer message.
APP_SEND_ENABLED=false
GATEWAY_ROUTING_MODE=SHADOW

DATABASE_URL=postgresql://lana_app:change_me@postgres:5432/lana_chatbot
REDIS_URL=redis://redis:6379

# Inject through a secret manager in production. Never commit real values.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ALLOWED_PAGE_IDS=
UPSALE_SUPPRESSION_ENABLED=false
HISTORY_CONTEXT_ENABLED=false
HISTORY_WRITE_ENABLED=false
CHAT_HISTORY_TTL_SECONDS=1728000
CHAT_HISTORY_MAX_MESSAGES=150
ADMIN_HISTORY_ENABLED=false
META_PAGE_ID=
INTERNAL_GATEWAY_KEY=
ANALYTICS_HASH_SALT=
ENVELOPE_MASTER_KEY_BASE64=
SHADOW_MIRROR_KEY=
SHADOW_EVALUATION_READ_KEY=
CATALOG_MIRROR_KEY=
BUSINESS_FACT_READ_KEY=
PANCAKE_ACCESS_TOKEN_FILE=
PANCAKE_EMPLOYEE_TAG_ID=
PANCAKE_POST_SALE_TAG_ID=
PANCAKE_CLOSED_ORDER_TAG_ID=
PANCAKE_NO_UPSALE_TAG_ID=
PANCAKE_TIMEOUT_MS=10000
SHADOW_DATABASE_URL=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-3.5-flash-lite
REALTIME_CONVERSATIONAL_MESSAGE_FORMAT_V1=true
REALTIME_MESSAGE_GROUPING_V2=true
VERTEX_CREDENTIAL_FILE=
SHADOW_DAILY_GENERATION_LIMIT=50
SHADOW_HOURLY_GENERATION_LIMIT=10
SHADOW_MIN_SOURCE_AGE_SECONDS=30
SHADOW_IMAGE=lana-chatbot-app:realtime-p1
SHADOW_REALTIME_GROUNDED_DRAFT_V1=false
SHADOW_REALTIME_VERIFIED_FACT_ASSEMBLER_V1=false
SHADOW_REALTIME_CUSTOMER_PROFILE_V1=false
SHADOW_REALTIME_VERIFIED_VARIANT_V2=false
SHADOW_REALTIME_CONTEXT_HISTORY_LIMIT=30
SHADOW_REALTIME_MULTI_FACT_QUERY_V2=false
SHADOW_REALTIME_CATALOG_ADVISORY_V1=false
SHADOW_REALTIME_DECISION_AUDIT_V2=false
SHADOW_REALTIME_JUDGE_V2_ENABLED=false
SHADOW_REALTIME_JUDGE_LIVE_SAMPLE_RATE=0.1
SHADOW_REALTIME_JUDGE_MODE=DRY_RUN
BUSINESS_FACT_MAX_AGE_SECONDS=1200
BUSINESS_NON_VOLATILE_MAX_AGE_SECONDS=172800
CATALOG_DEFAULT_SHOP_ALIAS=LANA
PRODUCT_SEARCH_ALLOWED_IMAGE_HOSTS=lanadesign.vn,content.pancake.vn,fbcdn.net,fbsbx.com
MEDIA_SEARCH_CACHE_TTL_SECONDS=604800
VIDEO_MAX_DURATION_SECONDS=60
VIDEO_MAX_BYTES=25165824
VIDEO_PROCESSING_TIMEOUT_MS=45000
MEDIA_WORKER_URL=http://media-worker:8090
MEDIA_WORKER_KEY_FILE=/run/secrets/media_worker_key

REDIS_STATE_TTL_SECONDS=1728000
REDIS_ANALYTICS_RETENTION_DAYS=20
POSTGRES_CHAT_RETENTION_MONTHS=6
HUMAN_LEASE_SECONDS=3600
ORDER_DRAFT_TTL_SECONDS=86400

# Admin UI + bounded conversation control plane. Production values are injected on the VPS.
ADMIN_BASE_URL=https://admin.lanadesign.vn
ADMIN_ALLOWED_ORIGIN=https://admin.lanadesign.vn
ADMIN_OWNER_EMAILS=nguyentuanson27@gmail.com
ADMIN_EDITOR_EMAILS=
ADMIN_APPROVER_EMAILS=
ADMIN_VIEWER_EMAILS=
ADMIN_PAGE_IDS=1198992073286645
ADMIN_DATABASE_URL_FILE=/run/secrets/admin_database_url
ADMIN_INTERNAL_AUTH_SECRET_FILE=/run/secrets/admin_internal_auth_secret
ADMIN_ASSERTION_ISSUER=lana-admin-web
ADMIN_CONTROL_ENABLED=false
ADMIN_CONTROL_PAGE_IDS=
ADMIN_POLICY_CONTROL_ENABLED=false
ADMIN_POLICY_PAGE_IDS=1198992073286645
ADMIN_POLICY_CANARY_LIVE_ENABLED=false
ADMIN_POLICY_PUBLISH_ENABLED=false
ADMIN_DATASET_REVIEW_V1=false
DATASET_AI_PRELABEL_V1=false
DATASET_BLIND_REVIEW_V1=false
DATASET_EXPORT_V1=false
ADMIN_CONTROL_DATABASE_URL_FILE=/run/secrets/admin_control_database_url
ADMIN_CONTROL_WORKER_ID=admin-control-worker-1
ADMIN_CONTROL_POLL_MS=1000
REALTIME_INBOUND_DEBOUNCE_MS=5000
REALTIME_POLL_MS=10000
REALTIME_CONCURRENCY=4
REALTIME_HEARTBEAT_MS=15000
RUNTIME_POLICY_ENABLED=false
RUNTIME_POLICY_CHANNEL=CANARY_SHADOW
RUNTIME_POLICY_CANARY_LIVE_ENABLED=false
RUNTIME_POLICY_PUBLISHED_ENABLED=false
RUNTIME_POLICY_CACHE_TTL_MS=5000
RUNTIME_POLICY_LKG_TTL_MS=300000
REALTIME_IMAGE=lana-chatbot-app:inbound-debounce-r1
REALTIME_CUSTOMER_PROFILE_V1=false
REALTIME_VERIFIED_VARIANT_V2=false
REALTIME_CONTEXT_HISTORY_LIMIT=30
REALTIME_MULTI_FACT_QUERY_V2=false
REALTIME_CATALOG_ADVISORY_V1=false
REALTIME_DECISION_AUDIT_V2=false
AD_ACQUISITION_ANALYTICS_MODE=OFF
AD_ACQUISITION_PAGE_ALLOWLIST=
AD_ACQUISITION_DERIVATION_VERSION=ad-acquisition-v1
AD_ACQUISITION_WINDOW_HOURS=168
AD_ACQUISITION_WAVE2_INPUT_ENABLED=false
ADMIN_SIMULATION_ENABLED=false
ADMIN_SIMULATION_DATABASE_URL_FILE=/run/secrets/admin_simulation_worker_database_url
ADMIN_SIMULATION_WORKER_ID=admin-simulation-worker-1
ADMIN_SIMULATION_POLL_MS=1000
ADMIN_SIMULATION_LEASE_MS=120000
ADMIN_SIMULATION_MAX_ATTEMPTS=3
ADMIN_CONTROL_LEASE_MS=60000
# Admin upload ảnh ngoài XML (production dùng secret file và HTTPS URL công khai).
ADMIN_PRODUCT_MEDIA_ENABLED=false
ADMIN_PRODUCT_MEDIA_DIR=/var/lib/lana/product-media
ADMIN_PRODUCT_MEDIA_ORIGINAL_DIR=/var/lib/lana/product-media-originals
ADMIN_PRODUCT_MEDIA_PUBLIC_BASE_URL=https://admin.lanadesign.vn/lana-public/products
ADMIN_PRODUCT_MEDIA_MAX_BYTES=8388608
ADMIN_PRODUCT_MEDIA_RESIZE_MAX_DIMENSION=1600
ADMIN_PRODUCT_MEDIA_RESIZE_CONCURRENCY=2
ADMIN_PRODUCT_MEDIA_ORIGINAL_TTL_MS=86400000
ADMIN_PRODUCT_MEDIA_CLEANUP_INTERVAL_MS=3600000
