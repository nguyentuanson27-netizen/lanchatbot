[Unit]
Description=Synchronize Lana MCP source pointer with the current production release
After=network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/lana-chatbot/current

[Service]
Type=oneshot
User=root
ExecStart=/opt/lana-chatbot/bin/lana-mcp-update-current-source.sh
TimeoutStartSec=2min
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/lana-chatbot/mcp-source /opt/lana-chatbot/repository/.git /run/lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
StandardOutput=journal
StandardError=journal
