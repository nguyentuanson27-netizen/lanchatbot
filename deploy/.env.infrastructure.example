# Copy to .env.infrastructure on the VPS, set mode 600, and use a generated password.
# This file is for PostgreSQL infrastructure only. Never commit the real file.
POSTGRES_DB=lana_chatbot
POSTGRES_USER=lana_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
AD_ACQUISITION_ANALYTICS_MODE=SHADOW
AD_ACQUISITION_PAGE_ALLOWLIST=1198992073286645
AD_ACQUISITION_DERIVATION_VERSION=ad-acquisition-v1
AD_ACQUISITION_WINDOW_HOURS=168
AD_ACQUISITION_WAVE2_INPUT_ENABLED=false
P23C_HASH_V3_MODE=OFF
P23C_PAYLOAD_ONLY_ENABLED=false
P23C_LEGACY_HASH_MIGRATION_ENABLED=false
P23C_MAX_PAYLOAD_UPDATES_PER_RUN=500
P23C_IMAGE_PREPROCESS_VERSION=ffmpeg-max-width-800-v1
P23C_CUTOUT_PIPELINE_VERSION=rembg-u2netp-v1
