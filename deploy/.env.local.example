# Local development only. Copy to .env.local and choose a strong, unique value.
# Never commit .env.local or reuse this database password in staging/production.
POSTGRES_DB=lana_chatbot
POSTGRES_USER=lana_chatbot
POSTGRES_PASSWORD=replace-with-a-local-only-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

