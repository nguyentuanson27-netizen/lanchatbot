# Public configuration. Do not put secrets in this file.
ADMIN_BASE_URL=https://admin.lanadesign.vn
ADMIN_ALLOWED_ORIGIN=https://admin.lanadesign.vn
ADMIN_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
ADMIN_PAGE_IDS=ALL

# Cloudflare Access
CLOUDFLARE_ACCESS_REQUIRED=true
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://REPLACE_TEAM_NAME.cloudflareaccess.com
CLOUDFLARE_ACCESS_JWKS_URL=https://REPLACE_TEAM_NAME.cloudflareaccess.com/cdn-cgi/access/certs
CLOUDFLARE_ACCESS_AUD=REPLACE_APPLICATION_AUD_TAG
ADMIN_OWNER_EMAILS=nguyentuanson27@gmail.com
CLOUDFLARE_ACCESS_JWKS_CACHE_SECONDS=300

# MVP safety defaults
ADMIN_PII_REVEAL_ENABLED=false
ADMIN_EXPORT_ENABLED=false
ADMIN_CONTROL_PLANE_ENABLED=false
ADMIN_REFRESH_SECONDS=5
ADMIN_SESSION_TTL_SECONDS=28800

# Secret file paths only. Create these files on the VPS; never commit contents.
CLOUDFLARE_TUNNEL_TOKEN_FILE=/run/secrets/cloudflare_tunnel_token
ADMIN_SESSION_SECRET_FILE=/run/secrets/admin_session_secret
ADMIN_DATABASE_URL_FILE=/run/secrets/admin_database_url
ADMIN_INTERNAL_AUTH_SECRET_FILE=/run/secrets/admin_internal_auth_secret
